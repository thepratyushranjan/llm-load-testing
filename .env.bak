# Copy to .env on each testing machine. Never put production credentials here.

# --- Identity --------------------------------------------------------------
MACHINE_ID=A                  # A | B | C
LOG_LEVEL=INFO

# --- Inference target (E2E vLLM) -------------------------------------------
VLLM_URL=http://mock-vllm:8000/v1
VLLM_API_KEY=devpass
VLLM_METRICS_URL=             # optional; defaults to <VLLM_URL minus /v1>/metrics
MODEL=Qwen2.5-VL-32B-Instruct

# --- Load shape ------------------------------------------------------------
PROFILE=smoke
TICK_SECONDS=5
BATCH_SIZE=1
FUNCTIONS=event,ai_info,extraction
JOB_DEADLINE_S=30
MAX_PIXELS=1003520

# --- Worker ----------------------------------------------------------------
# Total concurrency across all machines should be >= 1.5x vLLM --max-num-seqs.
WORKER_CONCURRENCY=64
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2

# --- Local ClickHouse (results stay on this machine) ------------------------
CLICKHOUSE_USER=loadtest
CLICKHOUSE_PASSWORD=devpass
CLICKHOUSE_DATABASE=loadtest

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=devpass
