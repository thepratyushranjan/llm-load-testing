# Application Settings
APP_NAME="LLM Load Testing API"
APP_VERSION="1.0.0"
DEBUG=False

# ClickHouse Settings
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Server Settings
HOST=0.0.0.0
PORT=8000

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Machine identity (A | B | C)
MACHINE_ID=A
LOG_LEVEL=INFO

# vLLM Settings (E2E Cloud)
VLLM_URL=https://<e2e-host>/v1
VLLM_API_KEY=
VLLM_METRICS_URL=
MODEL=Qwen2.5-VL-32B-Instruct

# Load Shape Settings
PROFILE=smoke
TICK_SECONDS=5
FUNCTIONS=event,ai_info,extraction
JOB_DEADLINE_S=30
MAX_PIXELS=1003520

# Worker Settings (total across machines >= 1.5x vLLM --max-num-seqs)
WORKER_CONCURRENCY=64
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Dataset Settings
IMAGE_VARIANTS_PX=1003520
VIDEO_VARIANTS_SIDE=1280
VIDEO_MAX_SECONDS=10
VIDEO_FPS=0
JPEG_QUALITY=90

# Request Settings
# E2E vLLM:        VLLM_URL=https://<e2e-host>/v1, VIDEO_INPUT=video
# Mock (no GPU):   VLLM_URL=http://mock-vllm:8000/v1  (docker compose --profile mock up -d)
# Local Ollama:    VLLM_URL=http://host.docker.internal:11434/v1, MODEL=gemma4:latest,
#                  VIDEO_INPUT=frames, EXTRA_BODY={"reasoning_effort": "none"}
GUIDED_JSON=false
EXTRA_BODY=
VIDEO_INPUT=video
VIDEO_FRAMES=4
VIDEO_SIDE=1280

# Mock vLLM Settings
MOCK_MAX_NUM_SEQS=16
MOCK_PREFILL_TOKENS_PER_S=8000
MOCK_DECODE_TOKENS_PER_S=40
MOCK_ERROR_RATE=0
MOCK_RATE_LIMIT_RATE=0
MOCK_HANG_RATE=0
MOCK_INVALID_JSON_RATE=0

# Queue Settings
MAX_DELIVERIES=3          # job handed out this many times (worker crashes) → DLQ
CLAIM_IDLE_S=0            # reclaim unacked jobs after this long (0 = 2 x REQUEST_TIMEOUT_S)
RETRY_BACKOFF_S=1.0       # first retry delay when the server sends no Retry-After; doubles per attempt
MAX_RPS=0                 # safety cap on requests/s from this machine (0 = no cap); keep above the planned load
RATE_BURST=0              # 0 = max(1, MAX_RPS)

# Auto-stop (per run: ./lt run --sla-p95-ms / --max-error-rate / --queue-growth-s / --no-auto-stop)
AUTO_STOP=true
SLA_P95_MS=0              # stop when p95 end-to-end latency exceeds this (0 = off until the SLA is agreed)
MAX_ERROR_RATE=0.02       # stop when > 2% of the last minute's requests fail
QUEUE_GROWTH_WINDOW_S=120 # stop when the backlog (Redis queue + vLLM waiting) rises at every check for this long

# This machine runs independently on the whole dataset
MACHINES=A

# Folder with your test images (and/or videos), scanned recursively, mounted read-only at /app/dataset.
# Optional sub-folders: trained|train and untrained|val|test set the split; event|ai_info|extraction limit a file to one function.
# Real events: a folder holding payload.json (the production event / ai-info JSON) + its images (+ video) is one case,
# sent exactly as production would, e.g. <DATASET_DIR>/events/<event_id>/{payload.json, 1.jpg, 2.jpg, 3.jpg, clip.mp4}
DATASET_DIR=/path/to/images
