# Application Settings
APP_NAME="LLM Load Testing API"
APP_VERSION="1.0.0"
DEBUG=False

# ClickHouse Settings
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Server Settings
HOST=0.0.0.0
PORT=8000

# Redis Settings
REDIS_URL=redis://redis:6379/0

# Machine identity (A | B | C)
MACHINE_ID=A
LOG_LEVEL=INFO

# vLLM Settings (E2E Cloud)
VLLM_URL=https://<e2e-host>/v1
VLLM_API_KEY=
VLLM_METRICS_URL=
MODEL=Qwen2.5-VL-32B-Instruct

# Load Shape Settings
PROFILE=smoke
TICK_SECONDS=5
BATCH_SIZE=1
FUNCTIONS=event,ai_info,extraction
JOB_DEADLINE_S=30
MAX_PIXELS=1003520

# Worker Settings (total across machines >= 1.5x vLLM --max-num-seqs)
WORKER_CONCURRENCY=64
REQUEST_TIMEOUT_S=30
MAX_RETRIES=2

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Dataset Settings
MACHINES=A,B,C
IMAGE_VARIANTS_PX=1003520,401408
VIDEO_VARIANTS_SIDE=1280,640
VIDEO_MAX_SECONDS=10
VIDEO_FPS=0
JPEG_QUALITY=90
ZONE_TYPE=office
